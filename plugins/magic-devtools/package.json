{
  "name": "@magic/dsh-devtools",
  "version": "0.1.0",
  "private": true,
  "description": "Magic developer tools (archive / git_ops) host plugin for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
