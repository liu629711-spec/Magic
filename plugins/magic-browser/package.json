{
  "name": "@magic/dsh-browser",
  "version": "0.1.0",
  "private": true,
  "description": "Magic agent browser plugin: Playwright-core driven Chromium with a live watch panel and mouse takeover (PRD-02 §18)",
  "license": "MIT",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib/client.js"
  ],
  "dsh": {
