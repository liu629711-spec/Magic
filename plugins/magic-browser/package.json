    "typecheck": "tsc -p .",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "playwright-core": "^1.54.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "esbuild": "^0.28.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "6.0.3"
  }
}
