  "boxShadow": {
    "hairline": "0 0 0 1px rgb(255 255 255 / 0.07)",
    "btn": "0 1px 2px rgba(0, 0, 0, 0.5), 0 0 0 1px rgb(255 255 255 / 0.09)",
    "gl-card": "0 1px 2px rgba(0, 0, 0, 0.4), 0 0 0 1px rgb(255 255 255 / 0.07)",
    "raised": "0 12px 32px rgba(0, 0, 0, 0.55), 0 0 0 1px rgb(255 255 255 / 0.07)",
    "overlay": "0 16px 48px rgba(0, 0, 0, 0.7), 0 0 0 1px rgb(255 255 255 / 0.09)"
  },
  "borderRadius": {
    "control": "7px",
    "chip": "6px",
    "gl-card": "14px",
    "DEFAULT": "0.125rem",
    "lg": "0.25rem",
    "xl": "0.5rem",
    "full": "0.75rem"
  },
  "maxWidth": {
    "80": "20rem",
    "95": "23.75rem",
    "105": "26.25rem"
  },
  "keyframes": {
    "pop-in": {
      "0%": { "opacity": "0", "transform": "scale(0.96) translateY(2px)" },
      "100%": { "opacity": "1", "transform": "scale(1) translateY(0)" }
    },
    "fade-up": {
      "0%": { "opacity": "0", "transform": "translateY(4px)" },
      "100%": { "opacity": "1", "transform": "translateY(0)" }
    },
    "fade-in": {
      "0%": { "opacity": "0" },
      "100%": { "opacity": "1" }
    },
    "shimmer-text": {
      "0%": { "background-position": "200% 0" },
      "100%": { "background-position": "-200% 0" }
    },
    "eq-bounce": {
      "0%, 100%": { "transform": "scaleY(0.4)" },
      "50%": { "transform": "scaleY(1)" }
    }
  },
  "animation": {
    "pop-in": "pop-in 220ms cubic-bezier(0.23,1,0.32,1) both",
    "fade-up": "fade-up 320ms cubic-bezier(0.23,1,0.32,1) both",
    "fade-in": "fade-in 200ms ease-out both"
  },
  "spacing": {
    "4.5": "1.125rem",
    "5.5": "1.375rem",
    "6.5": "1.625rem",
    "7.5": "1.875rem",
    "margin": "0.75rem",
    "space-lg": "1rem",
    "space-sm": "0.5rem",
    "space-xs": "0.25rem",
    "space-md": "0.75rem",
    "space-xl": "1.5rem",
    "gutter": "0.5rem"
  },
  "fontFamily": {
