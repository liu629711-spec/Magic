{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magic Tauri Runtime Spike",
  "version": "0.1.0",
  "identifier": "com.magic.desktop.runtime.spike",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Magic Tauri Runtime Spike",
        "width": 960,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:45173 http://127.0.0.1:45174 ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false
  }
}
